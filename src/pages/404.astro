---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — Free TXT to Image Converter | txttoimage"
  description="The page you are looking for does not exist. Return to our free text-to-image converter — convert TXT, code, CSV, JSON files to PNG or JPG. No upload, no sign-up, instant results."
  path="/404"
>
  <section class="min-h-[80dvh] flex flex-col items-center justify-center pt-20 pb-16">
    <div class="max-w-md mx-auto px-4 text-center">
      <p class="text-8xl font-bold text-zinc-200">404</p>
      <h1 class="mt-6 text-2xl md:text-3xl font-bold text-zinc-900 tracking-tight">Page Not Found</h1>
      <p class="mt-3 text-zinc-500">The page you are looking for does not exist or has been moved. Here are some helpful links:</p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a href="/" class="bg-emerald-500 hover:bg-emerald-600 active:scale-[0.98] text-white font-medium px-6 py-3 rounded-full transition-all duration-150">Back to Converter</a>
        <a href="/how-it-works" class="bg-white border border-zinc-200 hover:border-zinc-300 text-zinc-600 font-medium px-6 py-3 rounded-full transition-all duration-150">How It Works</a>
        <a href="/compare" class="bg-white border border-zinc-200 hover:border-zinc-300 text-zinc-600 font-medium px-6 py-3 rounded-full transition-all duration-150">Compare Tools</a>
        <a href="/contact" class="bg-white border border-zinc-200 hover:border-zinc-300 text-zinc-600 font-medium px-6 py-3 rounded-full transition-all duration-150">Contact</a>
      </div>
    </div>
  </section>
</Layout>
