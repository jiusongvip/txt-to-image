---
interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
}

const {
  title = "Try txttoimage Now",
  description = "100% client-side processing. No file uploads. Free forever.",
  buttonText = "Open the Converter"
} = Astro.props as Props;
---

<section class="py-16 bg-emerald-500">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">{title}</h2>
    <p class="mt-3 text-emerald-100 max-w-xl mx-auto">{description}</p>
    <a href="/#generator" class="inline-block mt-6 bg-white text-emerald-600 font-semibold px-8 py-3 rounded-full hover:bg-emerald-50 active:scale-[0.98] transition-all duration-150 shadow-sm">
      {buttonText}
    </a>
  </div>
</section>
