<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  const tocLinks = document.querySelectorAll('.toc-link');
  const sections = Array.from(tocLinks).map(link => {
    const id = link.getAttribute('href')?.replace('#', '');
    return id ? document.getElementById(id) : null;
  }).filter(Boolean);

  function updateActiveToc() {
    let current = '';
    sections.forEach(section => {
      if (section && section.getBoundingClientRect().top <= 120) {
        current = section.id;
      }
    });
    tocLinks.forEach(link => {
      const id = link.getAttribute('href')?.replace('#', '');
      if (id === current) {
        link.classList.add('text-emerald-600', 'bg-emerald-50', 'border-emerald-200');
        link.classList.remove('text-zinc-500', 'bg-zinc-50', 'border-zinc-200');
      } else {
        link.classList.remove('text-emerald-600', 'bg-emerald-50', 'border-emerald-200');
        link.classList.add('text-zinc-500', 'bg-zinc-50', 'border-zinc-200');
      }
    });
  }

  window.addEventListener('scroll', updateActiveToc, { passive: true });
</script>
